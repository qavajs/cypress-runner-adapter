{
  "name": "@qavajs/cypress-runner-adapter",
  "version": "2.0.0",
  "type": "module",
  "main": "supportCodeLibrary/index.js",
  "exports": {
    ".": "./supportCodeLibrary/index.js",
    "./adapter": "./adapter/index.js"
  },
  "files": [
    "adapter",
    "supportCodeLibrary",
    "index.d.ts",
    "adapter.d.ts"
  ],
  "scripts": {
    "debug": "cypress open --config-file test/cypress.config.js",
    "test": "cypress run --config-file test/cypress.config.js --browser chrome",
    "debug:it": "MODE=it cypress open --config-file test/cypress.config.js",
    "test:it": "MODE=it cypress run --config-file test/cypress.config.js --browser chrome",
    "debug:ts": "cypress open --config-file test/cypress-ts.config.js",
    "test:ts": "cypress run --config-file test/cypress-ts.config.js --browser chrome",
    "debug:ts:it": "MODE=it cypress open --config-file test/cypress-ts.config.js",
    "test:ts:it": "MODE=it cypress run --config-file test/cypress-ts.config.js --browser chrome"
  },
  "license": "MIT",
  "description": "feature file preprocessor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qavajs/cypress-runner-adapter.git"
  },
  "authors": [
    "Alexandr Galichenko"
  ],
  "bugs": {
    "url": "https://github.com/qavajs/cypress-runner-adapter/issues"
  },
  "homepage": "https://qavajs.github.io/docs/intro",
  "dependencies": {
    "@cucumber/cucumber-expressions": "^20.1.0",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/tag-expressions": "^11.0.1",
    "@cypress/webpack-preprocessor": "^8.0.0",
    "ts-loader": "^9.6.2"
  },
  "devDependencies": {
    "cypress": "^16.0.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "cypress",
    "cypress-plugin",
    "cypress-preprocessor",
    "qavajs",
    "cucumber",
    "gherkin",
    "test",
    "test-automation"
  ]
}
